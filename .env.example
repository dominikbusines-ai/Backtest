# Öffentliche Basis-URL der App, lokal oder auf Vercel
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Ausschließlich serverseitig verwenden. Niemals NEXT_PUBLIC_ voranstellen.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Ausschließlich serverseitig verwenden.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional: Vision-fähiges Modell überschreiben
ANTHROPIC_VISION_MODEL=claude-haiku-4-5
